<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="YouTrack Automation Suite" parallel="methods" thread-count="3" data-provider-thread-count="2">

    <!-- Глобальная регистрация слушателя для создания скриншотов при падении тестов -->
    <listeners>
        <listener class-name="utils.ScreenshotListener"/>
    </listeners>

    <test name="Login and Issue Management Tests">
        <classes>
            <class name="tests.LoginTest"/>
        </classes>
    </test>

</suite>